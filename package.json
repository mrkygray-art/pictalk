{
  "name": "pictalk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:emulator": "node scripts/setup-emulator.mjs",
    "dev:emulators": "vite --mode emulators",
    "emulators": "firebase emulators:start --project demo-pictalk --only auth,firestore,storage,functions",
    "test": "firebase emulators:exec --project demo-pictalk --only auth,firestore,storage,functions \"node --test --test-concurrency=1 tests/*.test.js\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^3.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
