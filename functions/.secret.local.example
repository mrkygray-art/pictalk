# Copied to functions/.secret.local by `npm run setup:emulator` (git-ignored).
# The Functions emulator reads secrets from here. Dummy values are fine when the
# stand-ins in .env.local are on. In production these are Firebase secrets:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set DEEPGRAM_API_KEY
ANTHROPIC_API_KEY=dummy-local-key
DEEPGRAM_API_KEY=dummy-local-key
