rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      match /stops/{stopId} {
        // Includes the fields the transcribeStop function adds, so the app can
        // still update a stop (e.g. its jobId) after it has been transcribed.
        function validStop() {
          let d = request.resource.data;
          return d.keys().hasOnly(['jobId', 'photoPath', 'audioPath', 'audioType', 'audioExpiresAt',
                                   'note', 'transcript', 'status', 'clientCreatedAt', 'createdAt',
                                   'transcriptConfidence', 'audioSeconds', 'transcriptModel',
                                   'transcribedAt', 'transcriptError'])
            && d.note is string && d.note.size() < 2000
            && (d.get('jobId', null) == null || (d.jobId is string && d.jobId.size() <= 64))
            && (d.photoPath == null || d.photoPath is string)
            && (d.audioPath == null || d.audioPath is string);
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && validStop();
      }

      match /jobs/{jobId} {
        function optNumber(d, k) {
          return d.get(k, null) == null || d.get(k, null) is number;
        }
        function optText(d, k) {
          return d.get(k, null) == null
            || (d.get(k, null) is string && d.get(k, null).size() <= 100);
        }
        function validJob() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'address', 'lat', 'lng', 'status',
                                   'startedAt', 'endedAt', 'lastStopAt',
                                   'customer', 'location', 'exportCount'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 200
            && d.status in ['open', 'finished']
            && d.startedAt is number
            && (d.get('address', null) == null
                || (d.address is string && d.address.size() <= 300))
            && optNumber(d, 'lat') && optNumber(d, 'lng')
            && optNumber(d, 'endedAt') && optNumber(d, 'lastStopAt')
            && optText(d, 'customer') && optText(d, 'location')
            && (d.get('exportCount', 0) is int && d.get('exportCount', 0) >= 0);
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && validJob();

        // AI draft summary. Only the generateJobSummary function creates it (Admin SDK);
        // the owner can read it and edit the text, items, and approval fields.
        // model, generatedAt, and generationCount stay function-only.
        match /ai/{docId} {
          function validSummaryEdit() {
            let d = request.resource.data;
            return docId == 'summary'
              && d.diff(resource.data).affectedKeys().hasOnly([
                   'summary', 'action_items', 'open_questions', 'status',
                   'approvedAt', 'approvedBy', 'approvedByUid', 'editedAt'])
              && d.summary is string && d.summary.size() <= 4000
              && d.action_items is list && d.action_items.size() <= 50
              && d.open_questions is list && d.open_questions.size() <= 50
              && d.status in ['draft', 'approved']
              && optNumber(d, 'approvedAt') && optNumber(d, 'editedAt')
              && (d.get('approvedBy', null) == null
                  || (d.approvedBy is string && d.approvedBy.size() <= 20))
              && (d.get('approvedByUid', null) == null || d.approvedByUid == uid);
          }
          allow read: if isOwner();
          allow update: if isOwner() && validSummaryEdit();
        }

        // Wrap-up notes: one per type ("field" / "customer"), owner only like the job.
        // The app adds audio pieces and the user's text; transcribeWrapUpNote (Admin SDK)
        // fills in transcripts.
        match /wrapUpNotes/{noteType} {
          function validNote() {
            let d = request.resource.data;
            return noteType in ['field', 'customer']
              && d.keys().hasOnly(['type', 'segments', 'durationSec', 'liveTranscript',
                                   'batchTranscript', 'text', 'transcriptSource', 'edited',
                                   'consentShown', 'createdBy', 'createdAt', 'updatedAt'])
              && d.type == noteType
              && (d.get('segments', []) is list && d.get('segments', []).size() <= 20)
              && (d.get('text', '') is string && d.get('text', '').size() <= 20000)
              && (d.get('edited', false) is bool)
              && (d.get('consentShown', false) is bool)
              && (d.get('durationSec', 0) is number)
              && (d.get('createdBy', uid) == uid)
              && optNumber(d, 'createdAt') && optNumber(d, 'updatedAt');
          }
          allow read, delete: if isOwner();
          allow create, update: if isOwner() && validNote();
        }
      }
    }
  }
}
