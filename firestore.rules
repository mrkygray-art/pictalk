rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/stops/{stopId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validStop() {
        let d = request.resource.data;
        return d.keys().hasOnly(['photoPath', 'audioPath', 'audioType', 'audioExpiresAt',
                                 'note', 'transcript', 'status', 'clientCreatedAt', 'createdAt'])
          && d.note is string && d.note.size() < 2000
          && (d.photoPath == null || d.photoPath is string)
          && (d.audioPath == null || d.audioPath is string);
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validStop();
    }
  }
}
