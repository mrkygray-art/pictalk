rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /photos/{uid}/{file} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Exported PDF reports, one per job (re-exporting replaces it). Stored so the
    // download link sends the file name, which some phone browsers otherwise ignore.
    match /exports/{uid}/{jobId}/{file} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
    // Piccolo finals: copies of a job's photos and audio, made by finalizePiccolo (never
    // written by the app, and outside voice/, so the 5-day voice lifecycle doesn't apply)
    match /finals/{uid}/{jobId}/{version}/{file} {
      allow read: if isOwner(uid);
    }
    match /voice/{uid}/{file} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
