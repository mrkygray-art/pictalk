# Copied to functions/.env.local by `npm run setup:emulator` (git-ignored).
# Free stand-ins, honored only inside the emulator (FUNCTIONS_EMULATOR=true).
# Summaries come from a stand-in instead of the Claude API:
PICTALK_FAKE_AI=1
# Transcripts and live words come from a stand-in instead of Deepgram:
PICTALK_FAKE_STT=1
# No daily AI limits for this test account (tests/limits.test.js); overrides functions/.env
UNLIMITED_AI_EMAILS=unlimited@example.com
